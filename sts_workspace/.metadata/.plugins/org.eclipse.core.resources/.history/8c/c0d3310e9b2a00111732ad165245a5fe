<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.themoviedb.www.movie.dao.MovieDao">
  <select id="selectBoardCount" resultType="_int"> 
    SELECT MOVIE_ID
		, POSTER_URL
		, TITLE, MOVIE_RATING
		, OPEN_DATE, OPEN_COUNTRY
		, RUNNING_TIME
		, INTRODUCE
		, SYNOPSIS
		, ORIGINAL_TITLE
		, STATE
		, "LANGUAGE"
		, BUDGET
		, PROFIT
     FROM TMDB.MOVIE
  </select>
  <select id="selectBoardList" resultType="org.themoviedb.www.movie.dao.MovieDao">
  SELECT MOVIE_ID
        , POSTER_URL
        , TITLE, MOVIE_RATING
        , OPEN_DATE, OPEN_COUNTRY
        , RUNNING_TIME
        , INTRODUCE
        , SYNOPSIS
        , ORIGINAL_TITLE
        , STATE
        , "LANGUAGE"
        , BUDGET
        , PROFIT
     FROM TMDB.MOVIE
  </select>
</mapper>