<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.themoviedb.www.files.dao.FilesDao">

	<insert id="insertAttachFile"
		parameterType="org.themoviedb.www.files.vo.request.UploadVO">
		INSERT INTO MOVIE.FILES
		(FILE_NUM
		, FILE_GROUP_ID
		, OBFUSCATE_NAME
		, DISPLAY_NAME
		, EXTEND_NAME
		, FILE_LENGTH
		, FILE_PATH)
		VALUES(
		(SELECT NVL(MAX(FILE_NUM), 0)+1
		FROM MOVIE.FILES
		WHERE
		FILE_GROUP_ID = #{fileGroupId})
		, #{fileGroupId}
		, #{obfuscateName}
		, #{displayName}
		, #{extendName}
		, #{fileLength}
		, #{filePath})
	</insert>
</mapper>