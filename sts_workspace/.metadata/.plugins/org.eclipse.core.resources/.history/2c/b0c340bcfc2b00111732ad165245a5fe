@charset "UTF-8";

* {
	box-sizing: border-box;
}

body {
	margin: 0;
	color: #333;
}

pre {
	margin: 0;
	font-size: 1rem;
}

/* Start grid style */
div.grid {
	display: grid;
	&
	>
	div
	.btn-group
	{
	grid-column
	:
	1
	/
	-1;
	&
	>
	div
	.right-align
	{
	text-align
	:
	right;
}

}
&
>
label {
	padding-left: 0.625rem;
}

&
input, & button, & textarea {
	padding: 0.625rem;
}

}
/* End grid style*/

/* 글 목록 style 시작 */
div.list {
  grid-template-columns: 1fr;
  grid-template-rows: 5rem 2rem 1fr 0.625rem;
}

div.list > table.grid > tbody > tr > td:nth-child(2) {
  max-width: calc(100vw - 709px);
}

/* 글 목록 style 끝 */
/* grid style 시작 */
div.grid {
  display: grid;
}

div.grid > div.btn-group {
  grid-column: 1 / -1;
}

div.grid > div.btn-group a {
  display: inline-block;
  padding: 0.4rem 0.625rem;
  color: #555;
  text-decoration: none;
}

div.grid > div.btn-group a:hover {
  color: #ff2d2d;
  text-decoration: underline;
}

div.grid > div.btn-group > div.right-align {
  text-align: right;
}

div.grid > label {
  padding-left: 0.625rem;
}

div.grid input,
div.grid button,
div.grid textarea {
  padding: 0.625rem;
}
/* grid style 끝 */

/* Start write content style */
div.write {
	grid-template-columns: 5rem 1fr;
	grid-template-rows: 1.75rem 1.75rem 20rem;
	row-gap: 0.625rem;
}
/* End write content style */

/* Start regist Style */
div.regist {
	margin: 0.625rem 10rem;
	row-gap: 0.625rem;
	flex-basis: 20rem;
}

/* End regist Style */

/* Start update Style */
div.update {
	margin: 0.625rem 10rem;
	row-gap: 0.625rem;
	flex-basis: 20rem;
}

/* End update Style */

/* Start view article style */
div.view {
	grid-template-columns: 7.5rem 1fr;
	grid-template-rows: repeat(8, minmax(1.75rem, auto));
	row-gap: 0.625rem;
}

.del-btn {
	border: 1px solid black;
	background-color: gray;
	padding: 0.625rem 1rem;
}

/* End view article style */
/* 게시글 내용 조회 style 시작 */
div.listview {
	grid-template-columns: 7.5rem 1fr;
	grid-template-rows: repeat(9, minmax(1.75rem, auto));
	row-gap: 0.625rem;
}
/* 게시글 내용 조회 style 끝 */