<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ktdsuniversity.edu.files.dao.FilesDao">
	<insert id="insertAttachFile"
		parameterType="com.ktdsuniversity.edu.files.vo.request.UploadVO">
		INSERT INTO SPRING_BOOT.FILES
		(FILE_NUM
		, FILE_GROUP_ID
		, OBFUSCATE_NAME
		, DISPLAY_NAME
		, EXTEND_NAME
		, FILE_LENGTH
		, FILE_PATH)
		VALUES(
	    (SELECT NVL(MAX(FILE_NUM), 0)+1
	    FROM SPRING_BOOT.FILES
	    WHERE FILE_GROUP_ID = #{fileGroupId})
		, #{fileGroupId}
		, #{obfuscateName}
		, #{displayName}
		, #{extendName}
		, #{fileLength}
		, #{filePath}
		)
	</insert>
	

    <select id="selectFilesByFileGroupAndFileNum" resultType="com.ktdsuniversity.edu.files.vo.response.DownloadVO" parameterType="com.ktdsuniversity.edu.files.vo.request.SearchFileVO">
    SELECT 
	   FILE_NUM
	, FILE_GROUP_ID 
	, OBFUSCATE_NAME
	, DISPLAY_NAME
	, EXTEND_NAME
	, FILE_LENGTH
	, FILE_PATH
	FROM SPRING_BOOT.FILES
	WHERE 	FILE_GROUP_ID =#{fileGroupId}
	  AND FILE_NUM= #{fileNum}
    </select>
    
    <delete id="deleteFilesById"  parameterType="string">
    DELETE FROM SPRING_BOOT.FILES
     WHERE FILE_GROUP_ID=#{_parameter} 
    </delete>
      
     
</mapper>