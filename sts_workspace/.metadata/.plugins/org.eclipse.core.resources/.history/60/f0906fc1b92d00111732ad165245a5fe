<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.themoviedb.www.movie.dao.MovieDao">
	<select id="selectMovieCount" resultType="_int">
		SELECT COUNT(MOVIE_ID)
		FROM TMDB.MOVIE
	</select>
	<select id="selectMovieList"
		resultType="org.themoviedb.www.movie.vo.MovieVO">
		SELECT MOVIE_ID
		, POSTER_URL
		, TITLE
		, MOVIE_RATING
		, TO_CHAR(OPEN_DATE, 'YYYY-MM-DD HH24:MI:SS') AS OPEN_DATE
		, OPEN_COUNTRY
		, RUNNING_TIME
		, INTRODUCE
		, SYNOPSIS
		, ORIGINAL_TITLE
		, STATE
		, "LANGUAGE"
		, BUDGET
		, PROFIT
		FROM TMDB.MOVIE
	</select>
    
	<insert id="insertNewMovie" parameterType="org.themoviedb.www.movie.vo.MovieVO">
		<selectKey order="BEFORE" resultType="string" keyProperty="movieID">
            SELECT 'MV-' || TO_CHAR(SYSDATE, 'YYYYMMDD-') ||
            LPAD(SEQ_MOVIE_PK.NEXTVAL,6,'0')
            FROM DUAL
        </selectKey>
		INSERT INTO TMDB.MOVIE
		(
		MOVIE_ID
		, POSTER_URL
		, TITLE
		, MOVIE_RATING, OPEN_DATE
		, OPEN_COUNTRY
		, RUNNING_TIME
		, INTRODUCE
		, SYNOPSIS
		, ORIGINAL_TITLE
		, STATE
		, "LANGUAGE"
		, BUDGET
		, PROFIT)
		VALUES(
		#{movieID}
		, #{posterUrl}
		, #{title}
		, #{movieRating}
		, ${openDate} 
		, #{openCountry}
		, #{runningTime}
		, #{introduce}
		, #{sysnopsis}
		, #{originalTitle}
		, #{state}
		, #{language}
		, #{budget}
		, #{profit})
	</insert>

</mapper>