<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ktdsuniversity.edu.members.dao.MembersDao">

	<insert id="insertNewMember"
		parameterType="com.ktdsuniversity.edu.members.vo.MemberVO">
		INSERT INTO SPRING_BOOT.MEMBERS
		(EMAIL
		, NAME
		, PASSWORD)
		VALUES(
		#{email}
		, #{name}
		, #{password}
		)
	</insert>

	<select id="selectMembersCount">
		SELECT COUNT(EMAIL)
		FROM SPRING_BOOT.MEMBERS
	</select>

	<select id="selectMemebers"
		resultType="com.ktdsuniversity.edu.members.vo.MemberVO">
		SELECT EMAIL
		, NAME
		, PASSWORD
		FROM SPRING_BOOT.MEMBERS
	</select>

	<select id="selectMemeber"
		resultType="com.ktdsuniversity.edu.members.vo.MemberVO"
		parameterType="string">
		SELECT EMAIL
		, NAME
		, PASSWORD
		FROM SPRING_BOOT.MEMBERS
		WHERE NAME=#{_parameter}

	</select>
</mapper>