<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.themoviedb.www.movie.dao.MovieDao">
	<select id="selectMovieCount" resultType="_int">
		SELECT COUNT(MOVIE_ID)
		FROM TMDB.MOVIE
	</select>
	<select id="selectMovieList"
		resultType="org.themoviedb.www.movie.vo.MovieVO">
		SELECT MOVIE_ID
		, POSTER_URL
		, TITLE
		, MOVIE_RATING
		, TO_CHAR(OPEN_DATE, 'YYYY-MM-DD HH24:MI:SS') AS OPEN_DATE
		, OPEN_COUNTRY
		, RUNNING_TIME
		, INTRODUCE
		, SYNOPSIS
		, ORIGINAL_TITLE
		, STATE
		, "LANGUAGE"
		, BUDGET
		, PROFIT
		FROM TMDB.MOVIE
	</select>
    
	<insert id="insertNewMovie" parameterType="org.themoviedb.www.movie.vo.MovieVO">
		<selectKey order="BEFORE" resultType="string" keyProperty="movieId">
            SELECT 'MV-' || TO_CHAR(SYSDATE, 'YYYYMMDD-') ||
            LPAD(SEQ_MOVIE_PK.NEXTVAL,6,'0')
            FROM DUAL
        </selectKey>
		INSERT INTO TMDB.MOVIE
		(
		MOVIE_ID
		, POSTER_URL
		, TITLE
		, MOVIE_RATING, OPEN_DATE
		, OPEN_COUNTRY
		, RUNNING_TIME
		, INTRODUCE
		, SYNOPSIS
		, ORIGINAL_TITLE
		, STATE
		, "LANGUAGE"
		, BUDGET
		, PROFIT)
		VALUES(
		#{movieId}
		, #{posterUrl}
		, #{title}
		, #{movieRating}
		, TO_DATE(#{openDate}, 'YYYY-MM-DD')
		, #{openCountry}
		, #{runningTime}
		, #{introduce}
		, #{synopsis}
		, #{originalTitle}
		, #{state}
		, #{language}
		, #{budget}
		, #{profit})
	</insert>
	
	<select id="findMovieByMovieId" parameterType="string" resultType="org.themoviedb.www.movie.vo.response.SelectResultForMovieUrlVO">
	MOVIE_ID
        , M.POSTER_URL
        , M.TITLE
        , M.MOVIE_RATING
        , TO_CHAR(M.OPEN_DATE, 'YYYY-MM-DD HH24:MI:SS') AS OPEN_DATE
        , M.OPEN_COUNTRY
        , M.RUNNING_TIME
        , M.INTRODUCE
        , M.SYNOPSIS
        , M.ORIGINAL_TITLE
        , M.STATE
        , M."LANGUAGE"
        , M.BUDGET
        , M.PROFIT
        , NVL(F.FILE_PATH, 0) 
        FROM TMDB.MOVIE M
       LEFT OUTER JOIN TMDB.FILES F
         ON M.MOVIE_ID = F.FILE_GROUP_ID 
       WHERE MOVIE_ID = #{movieId}
	</select>
</mapper>