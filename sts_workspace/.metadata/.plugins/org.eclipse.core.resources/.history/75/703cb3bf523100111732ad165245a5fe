<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.ktdsuniversity.edu.board.dao.BoardDao">
	<select id="selectBoardCount" resultType="_int">
		SELECT COUNT(ID)
		FROM
		BOARD
	</select>
	<select id="selectBoardList"
		resultType="com.ktdsuniversity.edu.board.vo.BoardVO">
		SELECT ID
		, SUBJECT
		, CONTENT
		, EMAIL
		, VIEW_CNT
		,
		TO_CHAR(CRT_DT, 'YYYY-MM-DD HH24:MI:SS') AS CRT_DT
		, TO_CHAR(MDFY_DT,
		'YYYY-MM-DD HH24:MI:SS') AS MDFY_DT
		, FILE_NAME
		, ORIGIN_FILE_NAME
		FROM
		BOARD
		ORDER BY ID DESC
	</select>

	<insert id="insertNewBoard"
		parameterType="com.ktdsuniversity.edu.board.vo.request.WriteVO">
		<!-- 새 게시글의 PK 미리 생성 후 WriteVO 의 ID 변수에 할당한담 -->
		<selectKey order="BEFORE" resultType="string"
			keyProperty="id">
			SELECT 'BO-' || TO_CHAR(SYSDATE, 'YYYYMMDD-') ||
			LPAD(SEQ_BOARD_PK.NEXTVAL,6,'0')
			FROM DUAL
		</selectKey>
		INSERT INTO SPRING_BOOT.BOARD
		(ID
		, SUBJECT
		, CONTENT
		,
		EMAIL
		, VIEW_CNT
		,
		CRT_DT
		, MDFY_DT
		, FILE_NAME
		,
		ORIGIN_FILE_NAME)
		VALUES(#{id}
		, #{subject}
		,
		#{content}
		, #{email}
		, 0
		, ''
		, ''
		, ''
		, '')
	</insert>

	<!-- <select id="selectBoardById" resultType="com.ktdsuniversity.edu.board.vo.BoardVO" 
		parameterType="string"> SELECT ID , SUBJECT , CONTENT , EMAIL , VIEW_CNT 
		, TO_CHAR(CRT_DT, 'YYYY-MM-DD HH24:MI:SS') AS CRT_DT , TO_CHAR(MDFY_DT, 'YYYY-MM-DD 
		HH24:MI:SS') AS MDFY_DT , FILE_NAME , ORIGIN_FILE_NAME FROM BOARD WHERE ID 
		= #{_parameter} </select> -->

	<!-- Join 을 사용하는 쿼리의 결과를 Has A를 사용하는VO에게 값읋 할당 하기 위한 수단 / resultMap -->
	<resultMap type="com.ktdsuniversity.edu.board.vo.BoardVO"
		id="BoardVOMap" autoMapping="true">

		<id column="ID" property="id"></id>
		<!-- <result column="SUBJECT" property="subject"></result> <result column="CONTENT" 
			property="content"></result> <result column="EMAIL" property="email"></result> 
			<result column="VIEW_CNT" property="viewCnt"></result> <result column="CRT_DT" 
			property="crtDt"></result> <result column="MDFY_DT" property="mdfyDt"></result> 
			<result column="FILE_NAME" property="fileName"></result> <result column="ORIGIN_FILE_NAME" 
			property="originFileName"></result> -->

		<collection property="files" javaType="list"
			ofType="com.ktdsuniversity.edu.files.vo.FilesVO" autoMapping="true">
			<id column="FILE_NUM" property="fileNum"></id>
			<id column="FILE_GROUP_ID" property="fileGroupId"></id>
			<!-- <result column="OBFUSCATE_NAME" property="obfuscateName"></result> 
				<result column="DISPLAY_NAME" property="displayName"></result> <result column="EXTEND_NAME" 
				property="extendName"></result> <result column="FILE_LENGTH" property="fileLength"></result> 
				<result column="FILE_PATH" property="filePath"></result> -->
		</collection>
	</resultMap>
	<select id="selectBoardById" resultMap="BoardVOMap"
		parameterType="string">
		SELECT B.ID
		,B.SUBJECT
		,B.CONTENT
		,B.EMAIL
		,B.VIEW_CNT
		,TO_CHAR(B.CRT_DT, 'YYYY-MM-DD HH24:MI:SS') AS CRT_DT
		,TO_CHAR(B.MDFY_DT, 'YYYY-MM-DD HH24:MI:SS') AS MDFY_DT
		,B.FILE_NAME
		,B.ORIGIN_FILE_NAME
		,F.FILE_NUM
		,F.FILE_GROUP_ID
		,F.OBFUSCATE_NAME
		,F.DISPLAY_NAME
		,F.EXTEND_NAME
		,F.FILE_LENGTH
		,F.FILE_PATH
		FROM BOARD B
		LEFT OUTER JOIN FILES F
		ON B.ID = F.FILE_GROUP_ID
		WHERE ID =
		#{_parameter}
	</select>

	<update id="updateViewCntIncreaseById" parameterType="string">
		UPDATE
		SPRING_BOOT.BOARD
		SET VIEW_CNT = (VIEW_CNT +1)
		WHERE ID = #{_parameter}
	</update>

	<delete id="deleteArticleByArticlId" parameterType="string">
		DELETE FROM
		SPRING_BOOT.BOARD
		WHERE ID=#{_parameter}
	</delete>

	<update id="updateBoardById"
		parameterType="com.ktdsuniversity.edu.board.vo.request.UpdateVO">
		UPDATE SPRING_BOOT.BOARD
		SET SUBJECT=#{subject}
		,
		CONTENT=#{content}
		, EMAIL=#{email}
		, MDFY_DT = SYSDATE
		WHERE ID=#{id}
	</update>



	String selectNewFileGroupId();
	<select id="selectNewFileGroupId" resultType="string">
	</select>

	int insertFileGroupId(String fileGroupId);

	<insert id="insertFileGroupId" parameterType="string">
	</insert>


</mapper>