			return result;
		}
		// 게시글 목록조회
		

		System.out.println("asbbbbbbbbbd " + count);
		
		List<MovieVO> list = this.movieDao.selectBoardList();

		System.out.println("cccccccccccccddd " + count);
		result.setResult(list);

		return result;
	}

	
}
