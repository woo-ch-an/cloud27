<%@ page language="java" contentType="text/html; charset=UTF-8"
	pageEncoding="UTF-8"%>
<%@taglib prefix="c" uri="jakarta.tags.core"%>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<link rel="stylesheet" href="/css/tmdb-web.css" type="text/css" />
<title>Movie List</title>
</head>
<body>
	<div class="wrapper">
		<h1>Movie List</h1>

		<table class="grid">

			<thead>
				<tr>
					<th>Movie Name</th>
					<th>Movie Rate</th>
					<th>Introduce</th>
					<th>Running Time</th>
				</tr>
			</thead>
			<tbody>
				<c:choose>
					<c:when>
						<c:forEach items>
						</c:forEach>
					</c:when>
					<c:otherwise>
					<tr> 
					<td colspan="4">No Data</td>
					</tr>
					</c:otherwise>
				</c:choose>

			</tbody>
		</table>

	</div>
</body>
</html>