<%@ page language="java" contentType="text/html; charset=UTF-8"
    pageEncoding="UTF-8"%>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<link rel="stylesheet" href="/css/hello-spring.css" type="text/css"/>
<title>게시글 조회 : 게시글 아이디</title>
</head>
<body>
<span> 첨부파일 </span>
<div>
<ul class="vertical-list">
<c:foreach items="${article.files}" var="file">
<li>
<a href="/file/${file.fileGroupId}/${file.fileNum}"> ${file.displayName}</a>
</li>
</c:foreach>
</ul>
</div>
<h1> 게시글 내용 조회</h1>
<div class="gird view"> 
    <span> id </span>
    <div>${article.id}</div>

        <span> subtitle </span>
    <div>${article.subject} </div>

    <span> email </span>
    <div>${article.email} </div>

    <span> viewCount  </span>
    <div>${article.viewCnt} </div>

    <span> creatDate   </span>
    <div>${article.crtDt}  </div>
    
	<span> mMdfiy date  </span>
    <div>${article.mdfyDt}  </div>
    
   <span>첨부파일 </span>
   <div> ${article.files}</div>
    
    <span> content  </span>
    <!-- pre => Presentation -->
    <pre>${article.content}</pre>

	<div class="btn-group">
		<div class="right-align"> 
			<a class="del-btn" href="/update/${article.id}">Update</a><a class="del-btn" href="/delete?id=${article.id}">Delete</a>
		</div>
	</div>
</div>
</body>
</html> 