@charset "UTF-8";
*{
    box-sizing: border-box;
}

body{
    margin:0;
    color:#333;
        background-color: #f7cbca;
}
.wrapper{
    margin : 0.625rem 10rem;
}
/* Start grid style */
.grid{ 
    border-collapse: collapse;
    border-spacing: 0;
  
    & > thead > tr > th {
        background-color: #Dc4225;
        font-weight: 600;
        color : #fff;
    } 

    & > tbody > tr:nth-child(even){
        
        background-color: #ff7062;
    }
    & > tbody > tr:nth-child(odd){

        background-color: #e35940;
    }
    & > tbody > tr > td:nth-child(even){
        text-align: center; 
    }
} 
/* End grid style*/
  