<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.themoviedb.www.members.dao.MembersDao">
	<select id="selectMemeberByEmail" parameterType="string"
		resultType="org.themoviedb.www.members.vo.MembersVO">

		SELECT EMAIL
		, NAME
		, PASSWORD
		FROM TMDB.MEMBERS
		WHERE EMAIL=#{_parameter}
	</select>
</mapper>