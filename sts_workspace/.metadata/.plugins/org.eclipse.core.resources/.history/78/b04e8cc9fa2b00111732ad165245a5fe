@charset "UTF-8";
*{
    box-sizing: border-box;
}

body{
    margin:0;
    color:#333;
}
pre{
    margin:0;
    font-size: 1rem;
}


/* Start grid style */
div.gird{
    display:grid; 

    & > div.btn-group {
        grid-column: 1/-1;

        & > div.right-align {
            text-align: right; 
        }
    }

    & > label{
        padding-left:0.625rem;
    }

    & input,
    & button,
    & textarea {
        padding: 0.625rem;
    }
} 
/* End grid style*/


/* table grid 시작 */
table.grid {
  border-collapse: collapse;
  width: 100%;
  border: 1px solid #ddd;
}

table.grid > tbody > tr:nth-child(odd) {
  background-color: #f5f5f5;
}

table.grid > tbody > tr:hover {
  background-color: #fafafa;
}

table.grid > thead > tr {
  background-color: #fff;
}

table.grid > thead > tr > th {
  padding: 0.625rem;
}

table.grid > thead > tr > th,
table.grid > tbody > tr > td {
  border-right: none;
  padding: 0.625rem;
  white-space: nowrap;
}
/* table grid 끝 */
/* Start write content style */
div.write{
    grid-template-columns: 5rem 1fr;
    grid-template-rows: 1.75rem 1.75rem 20rem;
    row-gap: 0.625rem;
}
/* End write content style */

/* Start regist Style */
div.regist{  
    margin : 0.625rem 10rem; 
    row-gap:0.625rem; 
    flex-basis: 20rem;
}

/* End regist Style */


/* Start update Style */
div.update{  
    margin : 0.625rem 10rem; 
    row-gap:0.625rem; 
    flex-basis: 20rem;
}

/* End update Style */

/* Start view article style */
div.view{ 
    grid-template-columns: 7.5rem 1fr;
    grid-template-rows: repeat(8, minmax(1.75rem, auto));
    row-gap: 0.625rem;
}

.del-btn{
    border : 1px solid black;
    background-color: gray;
padding:0.625rem 1rem;
}


/* End view article style */
/* 게시글 내용 조회 style 시작 */
div.listview {
  grid-template-columns: 7.5rem 1fr;
  grid-template-rows: repeat(9, minmax(1.75rem, auto));
  row-gap: 0.625rem;
}
/* 게시글 내용 조회 style 끝 */