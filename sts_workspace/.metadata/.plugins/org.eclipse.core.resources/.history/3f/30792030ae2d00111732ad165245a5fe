<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
  PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
  "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.themoviedb.www.movie.dao.MovieDao">
	<select id="selectMovieCount" resultType="_int">
		SELECT COUNT(MOVIE_ID)
		FROM TMDB.MOVIE
	</select>
	<select id="selectMovieList"
		resultType="org.themoviedb.www.movie.vo.MovieVO">
		SELECT MOVIE_ID
		, POSTER_URL
		, TITLE
		, MOVIE_RATING
		, TO_CHAR(OPEN_DATE, 'YYYY-MM-DD HH24:MI:SS') AS OPEN_DATE
		, OPEN_COUNTRY
		, RUNNING_TIME
		, INTRODUCE
		, SYNOPSIS
		, ORIGINAL_TITLE
		, STATE
		, "LANGUAGE"
		, BUDGET
		, PROFIT
		FROM TMDB.MOVIE
	</select>
	
	<insert id="insertNewBoard"
        parameterType="com.ktdsuniversity.edu.board.vo.request.WriteVO">
        <!-- 새 게시글의 PK 미리 생성 후 WriteVO 의 ID 변수에 할당한담 -->
        <selectKey order="BEFORE" resultType="string"
            keyProperty="id">
            SELECT 'BO-' || TO_CHAR(SYSDATE, 'YYYYMMDD-') ||
            LPAD(SEQ_BOARD_PK.NEXTVAL,6,'0')
            FROM DUAL
        </selectKey>
        INSERT INTO SPRING_BOOT.BOARD
        (ID
        , SUBJECT
        , CONTENT
        ,
        EMAIL
        , VIEW_CNT
        ,
        CRT_DT
        , MDFY_DT
        , FILE_NAME
        ,
        ORIGIN_FILE_NAME)
        VALUES(#{id}
        , #{subject}
        ,
        #{content}
        , #{email}
        , 0
        , ''
        , ''
        , ''
        , '')
    </insert>
    
    
	<insert id="insertNewMovie"
		parameterType="org.themoviedb.www.movie.vo.MovieVO">
		<selectKey order="BEFORE" resultType="string"
            keyProperty="id">
            SELECT 'BO-' || TO_CHAR(SYSDATE, 'YYYYMMDD-') ||
            LPAD(SEQ_BOARD_PK.NEXTVAL,6,'0')
            FROM DUAL
        </selectKey>
		INSERT INTO TMDB.MOVIE
		(
		MOVIE_ID
		, POSTER_URL
		, TITLE
		, MOVIE_RATING, OPEN_DATE
		, OPEN_COUNTRY
		, RUNNING_TIME
		, INTRODUCE
		, SYNOPSIS
		, ORIGINAL_TITLE
		, STATE
		, "LANGUAGE"
		, BUDGET
		, PROFIT)
		VALUES(
		#{id}
		, #{posterUrl}
		, #{title}
		, #{movieRating}
		, SYSDATE
		<!-- , '#{openDate}' -->
		, #{openCountry}
		, #{runningTime}
		, #{introduce}
		, #{sysnopsis}
		, #{originalTitle}
		, #{state}
		, #{language}
		, #{budget}
		, #{profit})
	</insert>

</mapper>