@charset "UTF-8";

* {
	box-sizing: border-box;
}

body {
	margin: 0;
	color: #333;
}

pre {
	margin: 0;
	font-size: 1rem;
}

/* Start list style*/
ul.vertical-list {
	margin: 0;
	padding: 0;
	list-style-type: none;
	display: flex;
	flex-direction: column;
	gap: 0.625rem;
}
/* End list style*/
/* Start grid style */
div.gird {
	display: grid;
	&
	>
	div
	.btn-group
	{
	grid-column
	:
	1
	/
	-1;
	&
	>
	div
	.right-align
	{
	text-align
	:
	right;
}

}
&
>
label {
	padding-left: 0.625rem;
}

&
input, & button, & textarea {
	padding: 0.625rem;
}

}
/* End grid style*/

/* Start write content style */
div.write {
	grid-template-columns: 5rem 1fr;
	grid-template-rows: repeat(3,minmax(1.75rem, auto)) 20rem;
	row-gap: 0.625rem; & > div .attach-files{ display : grid;
	grid-template-columns: 1fr minmax(5rem, auto);
	gap: 0.625rem;
	
	
}
& > div.inputdiv {
	& > .VaildationError{
	color:red;
	font-weight:600;
	font-size:0.8rem;
	margin-top:0.3rem;
	padding:0.5rem;
	background-color:#f002;
	}
 & > input{
	width:100%; 
	display:block;
	}}
}
/* End write content style */

/* Start regist Style */
div.regist {
	margin: 0.625rem 10rem;
	row-gap: 0.625rem;
	flex-basis: 20rem;
}

/* End regist Style */

/* Start update Style */
div.update {
	margin: 0.625rem 10rem;
	row-gap: 0.625rem;
	flex-basis: 20rem;
}

/* End  Style */

/* Start view article style */
div.view {
	grid-template-columns: 7.5rem 1fr;
	grid-template-rows: repeat(8, minmax(1.75rem, auto));
	row-gap: 0.625rem;
}

.update-file-list { 
	& > ul.vertical-list{
	 grid-column:1/ -1; 

	   & > li >	input[type="checkbox"]:checked + a {
	   color : red;
	   text-decoration:line-through;
}
}
}
.right-align {
	text-align: right;
}
